# ===== 必填：Odoo 連線（Odoo 後台 > 偏好設定 > 帳戶安全 > 新增 API 金鑰）=====
ODOO_URL=https://你的公司.odoo.com
ODOO_DB=你的資料庫名稱
ODOO_API_KEY=貼上你的金鑰

# ===== Email（預設關閉；設成 true 才會真的寄信）=====
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 收件人，多個用逗號分隔
MAIL_TO=
# 只准寄到這些網域（防止誤寄客戶），多個用逗號分隔
INTERNAL_DOMAINS=

# ===== 去重方式 =====
# db＝本機／固定主機（漏跑會補寄）；stateless＝Claude 雲端排程這類每次都是新環境的
STATE_MODE=db

# ===== 提醒規則（不填就用預設值）=====
# 追蹤哪些狀態：sent=已發送報價；要連草稿一起追蹤改成 sent,draft
TRACK_STATES=sent
# 到期前幾天發第二次提醒（7–14）
DUE_SOON_DAYS=7
# 第一、二次提醒相距少於幾天就只發第二次
MIN_GAP_DAYS=3
# 報價建立未滿幾天不提醒
MIN_AGE_DAYS=1
# 逾期超過幾天就不再列入
OVERDUE_MAX_DAYS=30
